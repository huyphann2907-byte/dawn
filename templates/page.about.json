      }
    },
    "about_guide": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Fewer pieces. Not more choices.",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Ashworn isn't built to give you more to pick from. It's built around one silhouette, used consistently across every piece — so sizing doesn't shift between orders, and fit doesn't become a guessing game.</p><p>That consistency is the product. Not a slogan on a shirt.</p>"
          }
        }
      },
