      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class='page-width ashworn-page-hero'><span class='ashworn-eyebrow ashworn-eyebrow--moss'>The Uniform Philosophy</span><h1 class='ashworn-page-hero__title'>Stop reinventing your closet every morning.</h1></div>",
