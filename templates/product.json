{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "size_guide": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<size-guide class='ashworn-size-guide'><details class='ashworn-size-guide__details'><summary class='ashworn-size-guide__summary caption-with-letter-spacing'>Size &amp; fit</summary><div class='ashworn-size-guide__content'><p>Cut oversized and boxy — length runs close to chest width. For a closer, regular fit, size down.</p><table class='ashworn-size-table'><thead><tr><th>Size</th><th>Chest (flat)</th><th>Length</th><th>Shoulder</th></tr></thead><tbody><tr><td>S</td><td>22&quot;</td><td>22.5&quot;</td><td>21&quot;</td></tr><tr><td>M</td><td>24&quot;</td><td>23.5&quot;</td><td>22&quot;</td></tr><tr><td>L</td><td>26&quot;</td><td>24.5&quot;</td><td>23&quot;</td></tr><tr><td>XL</td><td>28&quot;</td><td>25.5&quot;</td><td>24&quot;</td></tr></tbody></table><p class='ashworn-size-note'>Garment measured flat, in inches. Model wears M.</p></div></details></size-guide>"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "material_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Material & care",
            "icon": "shirt",
            "content": "<p>French Terry, 340gsm — 87% cotton, 13% polyester. Dense and structured, built to hold its shape. Machine wash cold, hang to dry.</p>",
            "page": ""
          }
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>Free U.S. shipping. Orders are dispatched within two business days and typically arrive in 3–5 business days. 30-day returns on unworn pieces.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "size_guide",
        "quantity_selector",
        "buy_buttons",
        "description",
        "material_tab",
        "shipping_tab",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "construction": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "French Terry, 340gsm — construction detail",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Built heavy, cut boxy",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>A dropped shoulder and a raw-cut hem, consistent on every piece we make. Dense enough to hold its structure wash after wash — weight you notice the moment you put it on.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "caption",
        "heading",
        "text"
      ],
      "settings": {
        "height": "large",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "image_behavior": "none",
        "content_layout": "no-overlap",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-2",
        "color_scheme": "scheme-2",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Complete the uniform",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "main",
    "construction",
    "related-products"
  ]
}
